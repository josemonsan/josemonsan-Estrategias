//@version=5
// ============================================================================
// MACD D1 (régimen) + SMA 800 6H (entrada) + Chandelier ATR (salida) — v3
//
// v2 (sin cambios):
//   S = Filtro de pendiente SMA800
//   D = Stop y trailing con ATR D1
//   R = Reentrada por ruptura de N velas
//
// v3 (nuevo, TODO apagado por defecto → con defaults v3 == v2 exacto):
//   M = RSI momentum: cruce/ruptura solo si RSI >= umbral (largos) / <= 100-umbral (cortos)
//   O = RSI techo: no perseguir entradas con RSI sobreextendido
//   K = Estocástico pullback: reentrada en tendencia cuando %K sale de sobreventa
//       (largos) / sobrecompra (cortos). Complementa a R: R reentra por fuerza,
//       K reentra por retroceso. M/O NO se aplican a K (un pullback tiene RSI bajo
//       por definición).
//
// AVISO: v2 ya está optimizada in-sample sobre BTC 6H. Añadir módulos sobre los
// mismos datos suma pruebas: contarlas todas en el DSR y validar fuera de muestra.
// Sin lookahead: D1 usa la vela diaria CERRADA anterior.
//
// Barrido BTCUSDT 6H 2018-2026 (btc/optimize_v3.py, 18.316 combinaciones; ver
// notes/2026-09-29-btc-6h-v3-oscillator-optimization.md):
//   M: redundante (cruce SMA800 / ruptura de 20 velas ya implican RSI > 50). Dejar OFF.
//   O: empeora en las 30 combinaciones, IS y OOS (retrasa las mejores entradas). Dejar OFF.
//   K: 14/3/20 empeora (DD 42 %). Solo 28/5/10 mejora algo (+2 operaciones en 2019,
//      DD 35,6 → 31,3 %), sin operaciones pullback en 2023-26 → no validado OOS.
//      Defaults de K cambiados a 28/5/10; K sigue apagado.
// ============================================================================
strategy("MACD_6h_v3", shorttitle="MACD-SMA800 v3", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.0035, slippage=1, pyramiding=0, process_orders_on_close=false)

// ---------------- Inputs ----------------
grpR = "Régimen D1"
macdFast     = input.int(12, "MACD rápida", group=grpR)
macdSlow     = input.int(26, "MACD lenta", group=grpR)
exitOnRegime = input.bool(true, "Salir si el régimen D1 se apaga", group=grpR)
holdTrend    = input.bool(false, "H · No salir por régimen si cierre y pendiente SMA siguen a favor", group=grpR,
     tooltip="Con régimen off, mantiene el largo mientras cierre > SMA y SMA > SMA[pendiente] (espejo en cortos). "
     + "Captura más las tendencias largas (2024-25) pero el Chandelier pasa a ser la salida real: usar Chandelier 6-8.")

grpE = "Entrada"
dirMode = input.string("Solo largos", "Dirección", options=["Ambas", "Solo largos", "Solo cortos"], group=grpE)
smaLen  = input.int(800, "SMA (velas del gráfico)", group=grpE)
useAdx  = input.bool(true, "A · Filtro ADX", group=grpE)
adxLen  = input.int(14, "ADX periodo", group=grpE)
adxThr  = input.float(20, "ADX mínimo", group=grpE)

grpV = "Mejoras v2"
useSlope   = input.bool(false, "S · Filtro pendiente SMA", group=grpV)
slopeLen   = input.int(20, "Pendiente: velas atrás (20 = 5 días en 6H)", group=grpV)
useAtrD    = input.bool(true, "D · Stop y trail con ATR D1", group=grpV)
useReentry = input.bool(true, "R · Reentrada por ruptura", group=grpV)
reLen      = input.int(20, "Ruptura: máx/mín de N velas", group=grpV)

grpO = "Osciladores v3"
rsiLen     = input.int(14, "RSI periodo", group=grpO)
useRsiMom  = input.bool(false, "M · RSI momentum en cruce/ruptura", group=grpO)
rsiMin     = input.float(50, "RSI mínimo largos (cortos: 100 − x)", minval=0, maxval=100, group=grpO)
useRsiCap  = input.bool(false, "O · RSI techo (no perseguir)", group=grpO)
rsiMax     = input.float(75, "RSI máximo largos (cortos: 100 − x)", minval=0, maxval=100, group=grpO)
useStochPb = input.bool(false, "K · Reentrada pullback estocástico", group=grpO)
stLen      = input.int(28, "Estocástico %K periodo", group=grpO)
stSmooth   = input.int(5, "Estocástico %K suavizado", group=grpO)
stOS       = input.float(10, "Sobreventa largos (cortos: 100 − x)", minval=1, maxval=50, group=grpO)

grpX = "Salida"
atrLen     = input.int(14, "ATR periodo", group=grpX)
slMult     = input.float(3.0, "Stop inicial (× ATR)", group=grpX)
chMult     = input.float(8.0, "Chandelier (× ATR)", group=grpX)
usePartial = input.bool(false, "P · Cierre parcial", group=grpX)
partialR   = input.float(2.0, "Parcial a (R)", group=grpX)
partialPct = input.int(50, "Parcial (%)", minval=1, maxval=99, group=grpX)

grpC = "Costes y comparación"
swapL     = input.float(0.0, "Swap largo (% anual, + = coste)", group=grpC)
swapS     = input.float(0.0, "Swap corto (% anual, + = coste)", group=grpC)
commBm    = input.float(0.0035, "Comisión % por cambio (benchmark)", group=grpC)
showD200  = input.bool(true, "Mostrar SMA200 D1 (equivalencia)", group=grpC)
showMarks = input.bool(true, "Marcar señales descartadas", group=grpC)

// ---------------- Cálculos ----------------
sma  = ta.sma(close, smaLen)
atr6 = ta.atr(atrLen)
[diP, diM, adx] = ta.dmi(adxLen, adxLen)
rsi  = ta.rsi(close, rsiLen)
stK  = ta.sma(ta.stoch(close, high, low, stLen), stSmooth)

macdD  = request.security(syminfo.tickerid, "D", (ta.ema(close, macdFast) - ta.ema(close, macdSlow))[1], lookahead=barmerge.lookahead_on)
smaD   = request.security(syminfo.tickerid, "D", ta.sma(close, 200)[1], lookahead=barmerge.lookahead_on)
closeD = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
atrD   = request.security(syminfo.tickerid, "D", ta.atr(atrLen)[1], lookahead=barmerge.lookahead_on)

atr = useAtrD ? atrD : atr6

regimeL = macdD > 0
regimeS = macdD < 0
adxOK   = not useAdx or adx > adxThr
slopeL  = not useSlope or sma > sma[slopeLen]
slopeS  = not useSlope or sma < sma[slopeLen]
allowL  = dirMode != "Solo cortos"
allowS  = dirMode != "Solo largos"

trendUp = close > sma and sma > sma[slopeLen]
trendDn = close < sma and sma < sma[slopeLen]

crossUp = ta.crossover(close, sma)
crossDn = ta.crossunder(close, sma)
hiBrk   = close > ta.highest(high, reLen)[1]
loBrk   = close < ta.lowest(low, reLen)[1]

// Filtros RSI (solo para cruce y ruptura)
rsiOKL = (not useRsiMom or rsi >= rsiMin) and (not useRsiCap or rsi <= rsiMax)
rsiOKS = (not useRsiMom or rsi <= 100 - rsiMin) and (not useRsiCap or rsi >= 100 - rsiMax)

// Disparadores por tipo
rawBrkL = useReentry and close > sma and hiBrk
rawBrkS = useReentry and close < sma and loBrk
okCrossL = crossUp and rsiOKL
okCrossS = crossDn and rsiOKS
okBrkL   = rawBrkL and rsiOKL
okBrkS   = rawBrkS and rsiOKS
okPbL    = useStochPb and close > sma and ta.crossover(stK, stOS)
okPbS    = useStochPb and close < sma and ta.crossunder(stK, 100 - stOS)

trigL = okCrossL or okBrkL or okPbL
trigS = okCrossS or okBrkS or okPbS

flatOrS = strategy.position_size <= 0
flatOrL = strategy.position_size >= 0

baseL = trigL and regimeL and allowL and flatOrS
baseS = trigS and regimeS and allowS and flatOrL

entryL = baseL and slopeL and adxOK
entryS = baseS and slopeS and adxOK

blockedSlope  = (baseL and not slopeL) or (baseS and not slopeS)
blockedAdx    = ((baseL and slopeL) or (baseS and slopeS)) and not adxOK
blockedRsi    = ((crossUp or rawBrkL) and not rsiOKL and not trigL and regimeL and allowL and flatOrS and slopeL and adxOK) or
                ((crossDn or rawBrkS) and not rsiOKS and not trigS and regimeS and allowS and flatOrL and slopeS and adxOK)
againstRegime = (crossUp and allowL and not regimeL) or (crossDn and allowS and not regimeS)

// ---------------- Estado de posición ----------------
var float riskL = na
var float trailL = na
var float tpL = na
var float hh = na
var bool tpDoneL = false

var float riskS = na
var float trailS = na
var float tpS = na
var float ll = na
var bool tpDoneS = false

var int nCross = 0
var int nBrk = 0
var int nPb = 0

if entryL
    typL = okCrossL ? "L cruce" : okBrkL ? "L ruptura" : "L pullback"
    strategy.entry("L", strategy.long, comment=typL)
    nCross  += okCrossL ? 1 : 0
    nBrk    += not okCrossL and okBrkL ? 1 : 0
    nPb     += not okCrossL and not okBrkL ? 1 : 0
    riskL   := slMult * atr
    trailL  := close - riskL
    tpL     := close + partialR * riskL
    hh      := close
    tpDoneL := false

if entryS
    typS = okCrossS ? "S cruce" : okBrkS ? "S ruptura" : "S pullback"
    strategy.entry("S", strategy.short, comment=typS)
    nCross  += okCrossS ? 1 : 0
    nBrk    += not okCrossS and okBrkS ? 1 : 0
    nPb     += not okCrossS and not okBrkS ? 1 : 0
    riskS   := slMult * atr
    trailS  := close + riskS
    tpS     := close - partialR * riskS
    ll      := close
    tpDoneS := false

posL = strategy.position_size > 0
posS = strategy.position_size < 0

if posL
    if usePartial and high >= tpL
        tpDoneL := true
    if strategy.position_size[1] <= 0
        avg = strategy.position_avg_price
        trailL := avg - riskL
        tpL    := avg + partialR * riskL
        hh     := high
    else
        hh := math.max(hh, high)
    trailL := math.max(trailL, hh - chMult * atr)

if posS
    if usePartial and low <= tpS
        tpDoneS := true
    if strategy.position_size[1] >= 0
        avg = strategy.position_avg_price
        trailS := avg + riskS
        tpS    := avg - partialR * riskS
        ll     := low
    else
        ll := math.min(ll, low)
    trailS := math.min(trailS, ll + chMult * atr)

if entryL or posL
    if usePartial and not tpDoneL
        strategy.exit("L-TP", "L", qty_percent=partialPct, limit=tpL, stop=trailL, comment="TP/Stop")
    strategy.exit("L-TS", "L", stop=trailL, comment="Trail")

if entryS or posS
    if usePartial and not tpDoneS
        strategy.exit("S-TP", "S", qty_percent=partialPct, limit=tpS, stop=trailS, comment="TP/Stop")
    strategy.exit("S-TS", "S", stop=trailS, comment="Trail")

if exitOnRegime and posL and not regimeL and not (holdTrend and trendUp) and not entryS
    strategy.close("L", comment="Régimen off")
if exitOnRegime and posS and not regimeS and not (holdTrend and trendDn) and not entryL
    strategy.close("S", comment="Régimen off")

// ---------------- Swap estimado ----------------
barDays = timeframe.in_seconds(timeframe.period) / 86400.0
var float swapCost = 0.0
if strategy.position_size != 0
    notional = math.abs(strategy.position_size) * close * syminfo.pointvalue
    rate = strategy.position_size > 0 ? swapL : swapS
    swapCost += notional * rate / 100 * barDays / 365

// ---------------- Drawdown de equity ----------------
var float peak = strategy.initial_capital
var float maxDD = 0.0
peak  := math.max(peak, strategy.equity)
maxDD := math.max(maxDD, (peak - strategy.equity) / peak)

// ---------------- Benchmark: largo/plano cierre D1 > SMA200 D1 ----------------
bmIn = not na(smaD) and closeD > smaD
var float bm = 1.0
if bmIn[1]
    bm *= close / close[1]
    bm *= 1 - swapL / 100 * barDays / 365
if bar_index > 0 and bmIn != bmIn[1]
    bm *= 1 - commBm / 100

// ---------------- Gráfico ----------------
plot(sma, "SMA 800", color=color.orange, linewidth=2)
plot(showD200 ? smaD : na, "SMA200 D1", color=color.new(color.gray, 30), style=plot.style_stepline)
bgcolor(regimeL ? color.new(color.green, 92) : regimeS ? color.new(color.red, 92) : na, title="Régimen D1")

plot(posL ? trailL : na, "Stop largo", color=color.red, style=plot.style_linebr)
plot(posL and usePartial and not tpDoneL ? tpL : na, "TP largo", color=color.teal, style=plot.style_linebr)
plot(posS ? trailS : na, "Stop corto", color=color.red, style=plot.style_linebr)
plot(posS and usePartial and not tpDoneS ? tpS : na, "TP corto", color=color.teal, style=plot.style_linebr)

plotshape(showMarks and blockedSlope, "Bloqueada: SMA plana", shape.diamond, location.abovebar, color.yellow, size=size.tiny)
plotshape(showMarks and blockedAdx, "Bloqueada: ADX", shape.xcross, location.abovebar, color.gray, size=size.tiny)
plotshape(showMarks and blockedRsi, "Bloqueada: RSI", shape.square, location.abovebar, color.purple, size=size.tiny)
plotshape(showMarks and againstRegime, "Cruce contra régimen", shape.circle, location.belowbar, color.silver, size=size.tiny)

// ---------------- Tabla ----------------
var table tb = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 15), border_width=1)
f_row(r, k, v) =>
    table.cell(tb, 0, r, k, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, r, v, text_color=color.white, text_size=size.small, text_halign=text.align_right)

if barstate.islast
    ic  = strategy.initial_capital
    ct  = strategy.closedtrades
    net = strategy.netprofit / ic * 100
    sw  = swapCost / ic * 100
    wr  = ct > 0 ? strategy.wintrades / ct * 100 : na
    pf  = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    tag = (usePartial ? "P" : "·") + (useAdx ? "A" : "·") + (useSlope ? "S" : "·") + (useAtrD ? "D" : "·") + (useReentry ? "R" : "·") + (holdTrend ? "H" : "·")
         + (useRsiMom ? "M" : "·") + (useRsiCap ? "O" : "·") + (useStochPb ? "K" : "·")
    f_row(0, "Variante (PASDRH·MOK)", tag)
    f_row(1, "Operaciones (parciales cuentan)", str.tostring(ct))
    f_row(2, "Entradas cruce/ruptura/pullback", str.tostring(nCross) + " / " + str.tostring(nBrk) + " / " + str.tostring(nPb))
    f_row(3, "Neto %", str.tostring(net, "#.##"))
    f_row(4, "Swap estimado %", str.tostring(-sw, "#.##"))
    f_row(5, "Neto − swap %", str.tostring(net - sw, "#.##"))
    f_row(6, "Win rate %", str.tostring(wr, "#.#"))
    f_row(7, "Profit factor", str.tostring(pf, "#.##"))
    f_row(8, "Max DD equity %", str.tostring(maxDD * 100, "#.##"))
    f_row(9, "Bench SMA200 D1 L/F %", str.tostring((bm - 1) * 100, "#.##"))
    f_row(10, "Timeframe", timeframe.period == "360" ? "6H ✓" : "⚠ Diseñada para 6H")
